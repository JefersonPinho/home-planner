generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String   @id
  name            String
  thumbnail       String?  @db.Text
  document        Json
  isTemplate      Boolean  @default(false)
  clientRevision  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomFurniture {
  id           String   @id
  name         String
  category     String
  width        Float
  depth        Float
  height       Float
  model        String
  color        String
  modelWidth   Float
  modelDepth   Float
  modelHeight  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
